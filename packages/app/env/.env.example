# 复制为 .env 后填真实值：cp .env.example .env
# 这里只放「基础设施命名」，不是密钥；GCS 鉴权走 `gcloud auth login`（落在 ~/.config/gcloud）
# 用途：① update:upload:gcs 上传产物　② 打包时把 publish.url 注入安装包

# GCP 项目 ID
GCP_PROJECT=your-gcp-project-id

# 存放更新产物的 bucket 名
UPDATE_BUCKET=your-update-bucket

# bucket 内对象前缀 / 目录名，用来区分 stable / beta（不填默认 desktop）
UPDATE_PREFIX=desktop-release

# 下载地址默认推导为 https://storage.googleapis.com/<bucket>/<prefix>，无需填写
# 仅在「接了独立 CDN 域名」时才需覆盖：
# UPDATE_PUBLISH_URL=https://updates.example.com/desktop-release
