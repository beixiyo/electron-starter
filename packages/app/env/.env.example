# 更新发布的 GCS 配置。只放「基础设施命名」，不是密钥；GCS 鉴权走 `gcloud auth login`（落在 ~/.config/gcloud）
#
# 按环境分流（测试服 / 生产服）——复制本文件为对应环境文件并填真实值：
#   cp .env.example .env.test          # 测试服
#   cp .env.example .env.production    # 生产服
#
# 加载规则（构建注入 publish.url 与上传共用同一套，保证地址一致）：
#   build:mac:test  / update:upload:gcs:test  → 读 .env.test
#   build:mac:prod  / update:upload:gcs:prod  → 读 .env.production

# Electron OAuth
# OAuth Center 的 DISPATCH_DESKTOP_BASE_URL 必须使用与 APP_PROTOCOL 相同的 scheme
VITE_ELECTRON_APPLE_CLIENT_ID=your-apple-service-id
VITE_ELECTRON_APPLE_REDIRECT_URI=https://oauth.example.com/callback/apple/desktop
VITE_ELECTRON_APPLE_SCOPE=name email
VITE_ELECTRON_GOOGLE_CLIENT_ID=your-google-client-id
VITE_ELECTRON_GOOGLE_REDIRECT_URI=https://oauth.example.com/callback/google/desktop

# Web OAuth（Web 构建仍使用浏览器 popup，不走桌面 deeplink）
VITE_WEB_APPLE_CLIENT_ID=your-apple-service-id
VITE_WEB_APPLE_REDIRECT_URI=https://web.example.com/oauth/callback/apple
VITE_WEB_APPLE_SCOPE=name email
VITE_WEB_APPLE_STATE=replace-with-project-value
VITE_WEB_GOOGLE_CLIENT_ID=your-google-client-id
VITE_WEB_GOOGLE_REDIRECT_URI=https://web.example.com/oauth/callback/google

# GCP 项目 ID
GCP_PROJECT=your-gcp-project-id

# 存放更新产物的 bucket 名（测试服 / 生产服各填各的）
UPDATE_BUCKET=your-update-bucket

# bucket 内对象前缀 / 目录名，用来区分环境 / 渠道（不填默认 desktop）
UPDATE_PREFIX=desktop-release

# 下载地址默认推导为 https://storage.googleapis.com/<bucket>/<prefix>，无需填写
# 仅在「接了独立 CDN 域名」时才需覆盖：
# UPDATE_PUBLISH_URL=https://updates.example.com/desktop-release
